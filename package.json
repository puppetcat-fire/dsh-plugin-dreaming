{
  "name": "dsh-plugin-dreaming",
  "version": "1.0.0",
  "description": "Raises skill consciousness strength: probes every skill call, records what really happened, and improves skill descriptions and boundaries nightly so skills are invoked precisely and tokens are not wasted.",
  "type": "module",
  "license": "MIT",
  "author": "肖博仁",
  "homepage": "https://github.com/puppetcat-fire/dsh-plugin-dreaming#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppetcat-fire/dsh-plugin-dreaming.git"
  },
  "bugs": {
    "url": "https://github.com/puppetcat-fire/dsh-plugin-dreaming/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "skills",
    "capability",
    "consciousness",
    "plugin"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-0",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
